# Environment ('development', 'production', or 'testing')
ENV=production

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database path (relative or absolute SQLite path)
DATABASE_PATH=phishing_platform.db

# RDAP Intelligence Configuration
RDAP_BASE_URL=https://rdap.org/domain/
RDAP_TIMEOUT_SECONDS=4.0

# CORS Allowed Origins (comma-separated, e.g. https://yourdomain.com,https://dashboard.yourdomain.com)
# Use * for development only
ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Max URL input length
MAX_URL_LENGTH=2048
